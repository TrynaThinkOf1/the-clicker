<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  
  <object class="GtkGrid" id="label_and_info_grid">
    <property name="halign">center</property>
    <property name="valign">center</property>
  
    <child>
      <object class="GtkLabel" id="macro_loader_label">
        <property name="label">Macro Editor</property>
        <property name="css-classes">click-timer-label</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>

    <!-- spacer between label and button-->
    <child>
      <object class="GtkLabel">
        <property name="label"> </property>
        <layout>
          <property name="column">1</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
  
    <child>
      <object class="GtkButton" id="macro_loader_info_button">
        <property name="css-classes">click-timer-info-button</property>
        <child>
          <object class="GtkImage" id="macro_loader_info_icon">
            <property name="resource">/com/the-clicker/graphics/assets/info_icon.png</property>
            <property name="pixel-size">18</property>
          </object>
        </child>
        <layout>
          <property name="column">2</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
  </object>
  
  <object class="GtkGrid" id="macro_loader_grid">
    <property name="row-spacing">8</property>
    <property name="column-spacing">8</property>
    <property name="column-homogeneous">True</property>
    
    <child>
      <object class="GtkEntry" id="macro_name_entry">
        <property name="max-length">50</property>
        <property name="tooltip-text">The name of the macro to create/import</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="column-span">3</property>
        </layout>
        <property name="placeholder-text">myMacro</property> 

        <property name="css-classes">coord-entry</property>
      </object>
    </child>

    <child>
      <object class="GtkButton" id="create_button">
        <property name="tooltip-text">Create a macro with the entered name</property>
        <layout>
          <property name="column">4</property>
          <property name="row">0</property>
          <property name="column-span">1</property>
        </layout>

        <child>
          <object class="GtkImage" id="create_button_icon">
            <property name="resource">/com/the-clicker/graphics/assets/plus_icon.png</property>
            <property name="pixel-size">16</property>
          </object>
        </child>

        <property name="css-classes">macro-loader-button</property>
      </object>
    </child>

    <child>
      <object class="GtkButton" id="import_button">
        <property name="tooltip-text">Import a macro with the entered name</property>
        <layout>
          <property name="column">5</property>
          <property name="row">0</property>
          <property name="column-span">1</property>
        </layout>
        
        <child>
          <object class="GtkImage" id="import_button_icon">
            <property name="resource">/com/the-clicker/graphics/assets/import_icon.png</property>
            <property name="pixel-size">16</property>
          </object>
        </child>

        <property name="css-classes">macro-loader-button</property>
      </object>
    </child>
  </object>
</interface>